{
  "system": "lqcs",
  "description": "Quantum measurement control system backend configuration",
  "backends": {
    "lqcs": {
      "enabled": true,
      "description": "Lab Quantum Control System - LabRAD-based measurement backend",
      "version": "1.0.0",
      "required_packages": ["lqms", "labrad", "pylab"]
    },
    "opensystemq": {
      "enabled": false,
      "description": "OpenSystemQ backend (future)",
      "version": "0.0.0",
      "required_packages": []
    },
    "qiskit": {
      "enabled": false,
      "description": "job_runner 插件槽位：预留的 QiskitBackend（尚未实现，启用会因找不到类而失败）。注意与下面的顶层 qiskit 块不是一回事。",
      "version": "0.0.0",
      "required_packages": ["qiskit"]
    }
  },
  "qiskit": {
    "enabled": true,
    "description": "quantum_service 的 qiskit/Aer 本地模拟后端（与 sq.* 真机后端并列的第三个后端）",
    "comment": "python_executable 指向装了 qiskit 的解释器。留空则要求 qiskit 装在服务自己的解释器里（进程内执行）；配了别的解释器则走子进程（qiskit_runner）。",
    "python_executable": "D:\\anaconda3\\envs\\qiskit\\python.exe",
    "shots": 2000,
    "seed": 42,
    "timeout_s": 120,
    "max_shots": 200000,
    "max_points": 501
  },
  "lqcs": {
    "connection": {
      "host": "localhost",
      "port": 7682,
      "timeout": 30
    },
    "session": {
      "default_user": "LQHL",
      "default_path": ["test", "20260822_device1"]
    },
    "paths": {
      "measure_scripts": null,
      "backend_dir": null
    }
  },
  "memory": {
    "window_size": 10,
    "summary_threshold": 20,
    "session_ttl": 86400
  }
}
