{
  "experiments": {
    "spectroscopy": {
      "name": "Spectroscopy",
      "description": "VNA spectroscopy — broad frequency scan to find qubit resonance",
      "function": "sq.spectroscopy",
      "qubits": 1,
      "defaultCommand": "sq.spectroscopy({qubit}, freq=np.arange(-0.1, 0.1, 0.002) + {qubit}.regs.f10)",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "f10"
      ]
    },
    "s21": {
      "name": "Cavity S21",
      "description": "Cavity S21 — narrowband frequency scan around cavity resonance",
      "function": "sq.s21",
      "qubits": 1,
      "defaultCommand": "sq.s21({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "fread"
      ]
    },
    "iqraw": {
      "name": "IQ Raw",
      "description": "Acquire raw I/Q data for qubit state discrimination",
      "function": "sq.iqraw",
      "qubits": 1,
      "defaultCommand": "sq.iqraw({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "qter.fitData({exp_num}, collect=True, do_plot=False)",
      "metricsToExtract": [
        "SNR",
        "F0",
        "F1",
        "separation"
      ]
    },
    "t1": {
      "name": "T1 Relaxation",
      "description": "Measure qubit relaxation time via variable delay pulse sequence",
      "function": "sq.t1",
      "qubits": 1,
      "defaultCommand": "sq.t1({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "T1"
      ]
    },
    "ramsey": {
      "name": "Ramsey",
      "description": "Ramsey with detuning — measure T2* dephasing time",
      "function": "sq.ramsey_df",
      "qubits": 1,
      "defaultCommand": "sq.ramsey_df({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "T2",
        "detuning"
      ]
    },
    "piamp": {
      "name": "Pi Pulse Amplitude",
      "description": "Calibrate π-pulse amplitude for X gate via Rabi oscillation",
      "function": "sq.piamp",
      "qubits": 1,
      "defaultCommand": "sq.piamp({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "pi_amplitude"
      ]
    },
    "xeb": {
      "name": "Cross-Entropy Benchmarking",
      "description": "Measure single-qubit gate fidelity",
      "function": "sq.xeb",
      "qubits": 1,
      "defaultCommand": "sq.xeb({qubit})",
      "defaultPlotCommand": "from lqms.data_process.xeb import process_xeb as px\npx.XEB(data,[{exp_num}],collect=True, do_plot=True)",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "gate_fidelity",
        "error_per_cycle"
      ]
    },
    "s21_dis": {
      "name": "S21 Dispersive Shift",
      "description": "Measure cavity transmission shift vs qubit state",
      "function": "sq.s21_dis",
      "qubits": 1,
      "defaultCommand": "sq.s21_dis({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "dispersive_shift"
      ]
    },
    "allxy": {
      "name": "AllXY",
      "description": "Characterize all 21 gate error combinations",
      "function": "sq.allxy",
      "qubits": 1,
      "defaultCommand": "sq.allxy({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "available": false,
      "note": "sq_nodes 没有 sq.allxy（21 种门错误组合实验未移植）。最接近的是 sq.time_rabi（单条 Rabi 扫描），只能部分替代。",
      "alternative": {
        "function": "sq.time_rabi",
        "defaultCommand": "sq.time_rabi({qubit})"
      },
      "metricsToExtract": [
        "average_fidelity",
        "leakage"
      ]
    },
    "single_shot": {
      "name": "Single-shot Fidelity",
      "description": "Measure qubit readout fidelity in single-shot regime",
      "function": "sq.single_shot",
      "qubits": 1,
      "defaultCommand": "sq.single_shot({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "available": false,
      "note": "sq_nodes 没有单发读出函数。可用 sq.iqraw（多次平均的 IQ 读出）近似态区分度，再用 sq.xeb 评估门保真度。",
      "alternative": {
        "function": "sq.iqraw",
        "defaultCommand": "sq.iqraw({qubit})"
      },
      "metricsToExtract": [
        "readout_fidelity"
      ]
    },
    "pulsed_spec": {
      "name": "Pulsed Spectroscopy",
      "description": "Qubit spectroscopy with pump pulse for higher SNR",
      "function": "sq.spectroscopy_iq",
      "qubits": 1,
      "defaultCommand": "sq.spectroscopy_iq({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "available": true,
      "note": "原 sq.pulsed_spec 在 sq_nodes 中不存在，已映射到脉冲谱学 sq.spectroscopy_iq。",
      "metricsToExtract": [
        "qubit_frequency"
      ]
    },
    "swap": {
      "name": "SWAP",
      "description": "Characterize SWAP gate for two-qubit operations",
      "function": "sq.swap",
      "qubits": 2,
      "defaultCommand": "sq.swap({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "available": false,
      "note": "sq_nodes 里没有 sq.swap（模块级函数）。真机的双比特 SWAP 走另一个模块：lqms.measure.tuners.cz_nodes.DCZTuner.swap11to20 —— 但它是**类方法**，要 2 比特 + 1 耦合器（qubits[2]），且当前 DSL/后端链（只会拼 sq.xxx(...)）调不到。详见 vendor_capabilities.two_qubit。",
      "metricsToExtract": [
        "swap_fidelity"
      ]
    },
    "drag_calibrate": {
      "name": "DRAG Calibration",
      "description": "Optimize DRAG coefficient for leakage suppression",
      "function": "sq.drag_calibrate",
      "qubits": 2,
      "defaultCommand": "sq.drag_calibrate({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "available": false,
      "note": "sq_nodes 没有 DRAG 自动标定函数。可用 sq.pulse_shape / sq.set_pi 手工调 alpha（DRAG 系数）后用 sq.xeb 观察泄漏是否下降。",
      "alternative": {
        "function": "sq.pulse_shape",
        "defaultCommand": "sq.pulse_shape({qubit})"
      },
      "metricsToExtract": [
        "optimal_drag"
      ]
    }
  },

  "vendor_capabilities": {
    "note": "厂商（lqms）能力登记。2026-11-19 内省本机 D:\\anaconda3\\envs\\lqcs 得到：sq_nodes 是编译版 .pyd，只导出 22 个实验函数（缺 pidf21）；双比特能力在 cz_nodes。",
    "sq_nodes": {
      "module": "lqms.measure.tuners.sq_nodes",
      "form": "模块级函数",
      "experiment_functions": [
        "iqraw", "iqcenter", "piamp", "pidf", "impa_gain",
        "t1", "ramsey_df", "ramsey_t2", "spinecho_t2", "xeb",
        "time_rabi", "test_timing_xyz",
        "spectroscopy", "spectroscopy_auto", "spectroscopy_iq",
        "s21", "s21_dis", "s21_power2d", "s21_zpa2d",
        "pulse_shape", "pulse_shape_ramsey", "set_pi"
      ],
      "missing_at_runtime": ["pidf21"],
      "two_qubit": false
    },
    "two_qubit": {
      "module": "lqms.measure.tuners.cz_nodes",
      "class": "DCZTuner",
      "init": "DCZTuner(qubits, gate_name='DCZGate', overwrite=False)",
      "form": "类方法（不是 sq.xxx 模块级函数）",
      "requires_coupler": true,
      "coupler_index": 2,
      "qubit_count": 2,
      "methods": [
        "initialize_gate", "swap11to20", "interaction",
        "find_zpa_c_half_cycle", "find_zpa_q", "zpa_c_m", "zpa_q_m",
        "sweep_sq_phase", "swap11to20_sq_phase", "gate_time_m",
        "zpa_q_czecho", "zpa_c_czecho", "gate_time_czecho",
        "sq_phase_xeb", "run_xeb", "tune"
      ],
      "experiment_classes": [
        "TQExperiment", "Swap11to20", "Swap11to20Entanglement",
        "Swap11to20SQphase", "CZEcho", "CZXeb", "Interaction", "CriticalZpaC"
      ],
      "batch": ["MultiDCZTuner", "SMTRunner"],
      "equivalent_methods": {
        "sq.swap": "swap11to20",
        "sq.drag_calibrate": "zpa_q_m"
      },
      "dsl_support": false,
      "dsl_gap": [
        "后端链只拼 sq.xxx(...) 模块级函数 → 调不到类方法",
        "DSL 的 qubits 列表描述不了**耦合器**（真机双比特要 2 比特 + 1 耦合器）",
        "词表里没有对应的 qubits 元数声明"
      ],
      "suggestion": "IR 侧建议加 coupler 字段（qubits [\"q0\",\"q1\"] + coupler \"c0\"），后端再加一条 cz_nodes 适配路径（DCZTuner(...) 生命周期 + registry 建键 + ZPA 标定前置）"
    }
  }
}
