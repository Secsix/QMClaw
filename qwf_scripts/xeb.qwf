# 实测脚本：交叉纠缠门保真度（XEB）（sq.xeb）
#
# 跑法（仓库根目录）：
#   python qwf_exp.py xeb            # 只打印计划，不跑
#   python qwf_exp.py xeb --if yes   # 真跑（后端由 quantum_service 按策略选）
#   python qwf_exp.py xeb --dry      # 干跑，不碰硬件
#
# 后端：本机没接 lqcs 真机时自动落到 qiskit/Aer；接了真机就跑真机。
# 参数口径：qiskit/Aer（points / df_hz / …）。上真机前请把 args 换成厂商口径，
#           参考 qwf_examples/03_t1_fixed_zpa.qwf 与 qwf_scripts/README.md。

workflow ex_xeb {
  meta {
    name        "ex_xeb"
    description "交叉纠缠门保真度 XEB"
    tags        ["xeb", "fidelity"]
  }

  env {
    qubit   "q2ld3"
  }

  budget {
    max_wall     40m
    max_writes   1
    max_datasets 2
  }

  measure as c1 {
    fn      sq.xeb
    qubit   $env.qubit
    timeout 1800
    note    "随机线路交叉验证（8 cycles × 12 sequences）"
    args {
      cycles 8
      sequences 12
    }
  }

  say "交叉纠缠门保真度（XEB） 测完"
}
