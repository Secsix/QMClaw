# 实测脚本：T1 弛豫时间（sq.t1）
#
# 跑法（仓库根目录）：
#   python qwf_exp.py t1            # 只打印计划，不跑
#   python qwf_exp.py t1 --if yes   # 真跑（后端由 quantum_service 按策略选）
#   python qwf_exp.py t1 --dry      # 干跑，不碰硬件
#
# 后端：本机没接 lqcs 真机时自动落到 qiskit/Aer；接了真机就跑真机。
# 参数口径：qiskit/Aer（points / df_hz / …）。上真机前请把 args 换成厂商口径，
#           参考 qwf_examples/03_t1_fixed_zpa.qwf 与 qwf_scripts/README.md。

workflow ex_t1 {
  meta {
    name        "ex_t1"
    description "T1 弛豫时间"
    tags        ["t1", "relaxation"]
  }

  env {
    qubit   "q2ld3"
  }

  budget {
    max_wall     10m
    max_writes   1
    max_datasets 2
  }

  measure as c1 {
    fn      sq.t1
    qubit   $env.qubit
    timeout 300
    note    "振幅衰减扫 T1（21 点）"
    args {
      points 21
      t1_us 50
      zpa 0.0
      delay range 0 2000 100
    }
  }

  say "T1 弛豫时间 测完"
}
