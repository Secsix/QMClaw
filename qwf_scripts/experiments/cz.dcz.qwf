# 实测脚本：两比特 CZ（DCZ）门保真度（cz.dcz）
#
# 跑法（仓库根目录）：
#   python tools/qwf_exp.py cz.dcz            # 只打印计划，不跑
#   python tools/qwf_exp.py cz.dcz --if yes   # 真跑（后端由 quantum_service 按策略选）
#   python tools/qwf_exp.py cz.dcz --dry      # 干跑，不碰硬件
#
# 后端：本机没接 lqcs 真机时自动落到 qiskit/Aer；接了真机就跑真机。
# 参数口径：qiskit/Aer（error_rate）。真机上 cz.dcz 走的是
#           cz_nodes.DCZTuner(qubits, gate_name='DCZGate', overwrite=False) 的类方法，
#           需要 2 比特 + 1 耦合器；coupler 是 IR 的独立字段（下面 measure 里给了 c0）。
#           真机侧还差：本机没有 lqms 运行时 + 设备画像没有 couplers 目录，
#           详见 config/experiment_configs.json 的 vendor_capabilities.two_qubit。

workflow ex_cz_dcz {
  meta {
    name        "ex_cz_dcz"
    description "两比特 CZ（DCZ）门保真度"
    tags        ["cz", "dcz", "two-qubit"]
  }

  env {
    qubit   "q2ld3"
  }

  budget {
    max_wall     10m
    max_writes   1
    max_datasets 2
  }

  measure as c1 {
    fn      cz.dcz
    # 双比特：词表里 cz.dcz 的 qubits=2，元数校验只看个数。
    # qiskit 路径固定用 q0/q1；上真机请改成两个物理比特名。
    qubits  ["q0", "q1"]
    # 可调耦合器：cz.dcz 在词表里 requires_coupler=true，IR 里是独立字段
    # （不是第三个比特），缺了校验会报 E_COUPLER_REQUIRED。
    coupler "c0"
    timeout 300
    note    "两比特 CZ（DCZ）（q0/q1，耦合器 c0）"
    args {
      error_rate 0.01
    }
  }

  say "两比特 CZ 门保真度 测完"
}
