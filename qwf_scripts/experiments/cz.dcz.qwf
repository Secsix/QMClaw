# 实测脚本：两比特 CZ（DCZ）门保真度（cz.dcz）
#
# 跑法（仓库根目录）：
#   python qwf_exp.py cz.dcz            # 只打印计划，不跑
#   python qwf_exp.py cz.dcz --if yes   # 真跑（后端由 quantum_service 按策略选）
#   python qwf_exp.py cz.dcz --dry      # 干跑，不碰硬件
#
# 后端：本机没接 lqcs 真机时自动落到 qiskit/Aer；接了真机就跑真机。
# 参数口径：qiskit/Aer（error_rate）。真机上 cz.dcz 走的是
#           cz_nodes.DCZTuner(qubits, gate_name='DCZGate', overwrite=False) 的类方法，
#           需要 2 比特 + 1 耦合器，当前 DSL/后端链还调不到 —— 详见
#           config/experiment_configs.json 的 vendor_capabilities.two_qubit。

workflow ex_cz_dcz {
  meta {
    name        "ex_cz_dcz"
    description "两比特 CZ（DCZ）门保真度"
    tags        ["cz", "dcz", "two-qubit"]
  }

  env {
    qubit   "q2ld3"
  }

  budget {
    max_wall     10m
    max_writes   1
    max_datasets 2
  }

  measure as c1 {
    fn      cz.dcz
    # 双比特：词表里 cz.dcz 的 qubits=2，元数校验只看个数。
    # qiskit 路径固定用 q0/q1；上真机请改成两个物理比特名。
    qubits  ["q0", "q1"]
    timeout 300
    note    "两比特 CZ（DCZ）（q0/q1）"
    args {
      error_rate 0.01
    }
  }

  say "两比特 CZ 门保真度 测完"
}
