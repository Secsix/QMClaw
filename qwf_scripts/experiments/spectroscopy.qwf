# 实测脚本：VNA 扫频找共振（sq.spectroscopy）
#
# 跑法（仓库根目录）：
#   python tools/qwf_exp.py spectroscopy            # 只打印计划，不跑
#   python tools/qwf_exp.py spectroscopy --if yes   # 真跑（后端由 quantum_service 按策略选）
#   python tools/qwf_exp.py spectroscopy --dry      # 干跑，不碰硬件
#
# 后端：本机没接 lqcs 真机时自动落到 qiskit/Aer；接了真机就跑真机。
# 参数口径：qiskit/Aer（points / df_hz / …）。上真机前请把 args 换成厂商口径，
#           参考 qwf_scripts/examples/03_t1_fixed_zpa.qwf 与 qwf_scripts/README.md。

workflow ex_spectroscopy {
  meta {
    name        "ex_spectroscopy"
    description "VNA 扫频找共振"
    tags        ["spectroscopy", "resonance"]
  }

  env {
    qubit   "q1"
  }

  budget {
    max_wall     10m
    max_writes   1
    max_datasets 2
  }

  measure as c1 {
    fn      sq.spectroscopy
    qubit   $env.qubit
    timeout 300
    note    "扫频找比特共振（51 点）"
    args {
      points 51
      df_hz 5000000
      # 厂商口径必须显式给 freq（不给会报 E_SPEC_NO_FREQ）。
      # 区间按 q1 的 f10≈3.62 GHz 取；步长 0.002 → 51 个点。
      # **点数别乱加**：下发前的耗时闸门按真机速度估（≈1 s/点），
      # 600 个点会估成 606s > timeout=300s 直接 Halt。
      freq range 3.6 3.7 0.002
    }
  }

  say "VNA 扫频找共振 测完"
}
