# 实测脚本：Ramsey 退相干 T2（sq.ramsey_df）
#
# 跑法（仓库根目录）：
#   python tools/qwf_exp.py ramsey            # 只打印计划，不跑
#   python tools/qwf_exp.py ramsey --if yes   # 真跑（后端由 quantum_service 按策略选）
#   python tools/qwf_exp.py ramsey --dry      # 干跑，不碰硬件
#
# 后端：本机没接 lqcs 真机时自动落到 qiskit/Aer；接了真机就跑真机。
# 参数口径：qiskit/Aer（points / df_hz / …）。上真机前请把 args 换成厂商口径，
#           参考 qwf_scripts/examples/03_t1_fixed_zpa.qwf 与 qwf_scripts/README.md。

workflow ex_ramsey {
  meta {
    name        "ex_ramsey"
    description "Ramsey 退相干 T2"
    tags        ["ramsey", "t2"]
  }

  env {
    qubit   "q1"
  }

  budget {
    max_wall     10m
    max_writes   1
    max_datasets 2
  }

  measure as c1 {
    fn      sq.ramsey_df
    qubit   $env.qubit
    timeout 300
    note    "Ramsey 振荡衰减拟合 T2（41 点）"
    args {
      points 41
      t2_us 20
    }
  }

  say "Ramsey 退相干 T2 测完"
}
