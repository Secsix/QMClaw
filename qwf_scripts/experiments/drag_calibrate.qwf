# 实测脚本：两比特 DRAG 参数标定（sq.drag_calibrate）
#
# 跑法（仓库根目录）：
#   python tools/qwf_exp.py drag_calibrate            # 只打印计划，不跑
#   python tools/qwf_exp.py drag_calibrate --if yes   # 真跑（后端由 quantum_service 按策略选）
#   python tools/qwf_exp.py drag_calibrate --dry      # 干跑，不碰硬件
#
# 后端：本机没接 lqcs 真机时自动落到 qiskit/Aer；接了真机就跑真机。
# 参数口径：qiskit/Aer（points / df_hz / …）。上真机前请把 args 换成厂商口径，
#           参考 qwf_examples/03_t1_fixed_zpa.qwf 与 qwf_scripts/README.md。

workflow ex_drag_calibrate {
  meta {
    name        "ex_drag_calibrate"
    description "两比特 DRAG 标定"
    tags        ["drag", "two-qubit"]
  }

  env {
    qubit   "q2ld3"
  }

  budget {
    max_wall     10m
    max_writes   1
    max_datasets 2
  }

  measure as c1 {
    fn      sq.drag_calibrate
    # 双比特：元数校验只看个数（config/experiment_configs.json 里 swap/drag_calibrate 都是 2）。
    # qiskit 路径固定用 q0/q1；上真机请改成两个物理比特名。
    qubits  ["q0", "q1"]
    timeout 300
    note    "扫 DRAG alpha 找泄漏最小点"
    args {
      points 41
      alpha_min -1.0
      alpha_max 1.0
    }
  }

  say "两比特 DRAG 参数标定 测完"
}
