# 实测脚本：单发读出保真度（sq.single_shot）
#
# 跑法（仓库根目录）：
#   python tools/qwf_exp.py single_shot            # 只打印计划，不跑
#   python tools/qwf_exp.py single_shot --if yes   # 真跑（后端由 quantum_service 按策略选）
#   python tools/qwf_exp.py single_shot --dry      # 干跑，不碰硬件
#
# 后端：本机没接 lqcs 真机时自动落到 qiskit/Aer；接了真机就跑真机。
# 参数口径：qiskit/Aer（points / df_hz / …）。上真机前请把 args 换成厂商口径，
#           参考 qwf_examples/03_t1_fixed_zpa.qwf 与 qwf_scripts/README.md。

workflow ex_single_shot {
  meta {
    name        "ex_single_shot"
    description "单发读出保真度"
    tags        ["readout", "fidelity"]
  }

  env {
    qubit   "q2ld3"
  }

  budget {
    max_wall     10m
    max_writes   1
    max_datasets 2
  }

  measure as c1 {
    fn      sq.single_shot
    qubit   $env.qubit
    timeout 300
    note    "单发读出（含误判）"
    args {
      p_readout 0.03
    }
  }

  say "单发读出保真度 测完"
}
