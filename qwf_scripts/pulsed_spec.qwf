# 实测脚本：IQ 域谱学（sq.spectroscopy_iq）
#
# 跑法（仓库根目录）：
#   python qwf_exp.py pulsed_spec            # 只打印计划，不跑
#   python qwf_exp.py pulsed_spec --if yes   # 真跑（后端由 quantum_service 按策略选）
#   python qwf_exp.py pulsed_spec --dry      # 干跑，不碰硬件
#
# 后端：本机没接 lqcs 真机时自动落到 qiskit/Aer；接了真机就跑真机。
# 参数口径：qiskit/Aer（points / df_hz / …）。上真机前请把 args 换成厂商口径，
#           参考 qwf_examples/03_t1_fixed_zpa.qwf 与 qwf_scripts/README.md。

workflow ex_pulsed_spec {
  meta {
    name        "ex_pulsed_spec"
    description "IQ 域谱学"
    tags        ["spectroscopy", "iq"]
  }

  env {
    qubit   "q2ld3"
  }

  budget {
    max_wall     10m
    max_writes   1
    max_datasets 2
  }

  measure as c1 {
    fn      sq.spectroscopy_iq
    qubit   $env.qubit
    timeout 300
    note    "IQ 域扫频（51 点）"
    args {
      points 51
      df_hz 5000000
    }
  }

  say "IQ 域谱学 测完"
}
